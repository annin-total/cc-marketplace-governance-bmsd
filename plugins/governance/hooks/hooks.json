{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" UserPromptSubmit"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" UserPromptExpansion"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" PostToolUseFailure"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" PreCompact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/collect.py\" Stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" SessionStart"
          }
        ]
      }
    ]
  }
}
